#include <stdio.h>
#include <string.h>

void removeSubstring(char *str, const char *sub) {
    char *p = strstr(str, sub);
    if (p != NULL) {
        memmove(p, p + strlen(sub), strlen(p + strlen(sub)) + 1);
    }
}

int main() {
    char str[] = "yellow";
    const char *sub = "low";
    
    printf("Исходная строка: %s\n", str);
    removeSubstring(str, sub);
    printf("Результат: %s\n", str);
    
    return 0;
}
